[Desktop Entry]
Type=Application
Name=Dr Stein
GenericName=Disk and disk-image tool
Comment=Inspect, image, browse and repair disks and disk images
Exec=dr-stein %F
Icon=dr-stein
Terminal=false
Categories=System;Filesystem;
Keywords=disk;partition;image;backup;restore;hex;
MimeType=application/vnd.efi.img;application/x-raw-disk-image;application/vnd.efi.iso;application/x-cd-image;application/x-iso9660-image;application/x-qemu-disk;application/x-vdi-disk;application/x-vhd-disk;application/x-vhdx-disk;application/x-vmdk-disk;application/x-apple-diskimage;
StartupNotify=true
